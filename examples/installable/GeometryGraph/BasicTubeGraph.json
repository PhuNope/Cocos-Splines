{
  "version": 1,
  "nodes": [
    {
      "id": "source",
      "type": "spline"
    },
    {
      "id": "offset",
      "type": "offset",
      "input": "source",
      "right": 0,
      "up": 0.15
    },
    {
      "id": "width",
      "type": "width",
      "input": "offset",
      "multiplier": 1
    },
    {
      "id": "tube",
      "type": "tube",
      "input": "width",
      "radius": 0.75,
      "radialSegments": 16,
      "uvMetersPerRepeat": 4,
      "capEnds": true
    },
    {
      "id": "output",
      "type": "output",
      "input": "tube"
    }
  ],
  "output": "output"
}
