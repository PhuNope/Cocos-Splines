{
  "version": 1,
  "nodes": [
    {
      "id": "source",
      "type": "spline"
    },
    {
      "id": "transform",
      "type": "transform",
      "input": "source",
      "translateY": 1,
      "rotateY": 30,
      "pathScale": 1.5
    },
    {
      "id": "tube",
      "type": "tube",
      "input": "transform",
      "radius": 0.25,
      "radialSegments": 12,
      "uvMetersPerRepeat": 2
    },
    {
      "id": "output",
      "type": "output",
      "input": "tube"
    }
  ],
  "output": "output"
}
