{
  "package_version": 2,
  "name": "cocos-splines",
  "version": "2.0.0-dev",
  "description": "Clean Cocos Creator 3.8 spline authoring, procedural geometry, independent Path consumers, and required Cocos-Gizmos v3.",
  "license": "MIT",
  "editor": ">=3.8.2",
  "main": "./dist/v2/clean-main.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "verify": "node scripts/verify.cjs",
    "test": "node scripts/test-v2.cjs",
    "check:v2": "tsc -p tsconfig.v2.json",
    "check:v2-editor": "tsc -p tsconfig.v2-editor.json",
    "pack:v2-test": "node scripts/pack-v2-test.cjs"
  },
  "cocosSplines": {
    "requiredExtensions": {
      "cocos-gizmos": ">=3.0.2"
    },
    "requiredSceneApi": [
      "Gizmos3D.move",
      "Gizmos3D.rotate",
      "Gizmos2D.rotate",
      "Gizmos3D.supportsRotationPivot",
      "GizmoHUD.createHud",
      "GizmoHUD.bind",
      "GizmoHUD.action"
    ]
  },
  "contributions": {
    "scene": {
      "script": "./dist/v2/clean-scene.js"
    },
    "asset-db": {
      "mount": {
        "path": "./assets",
        "readonly": true
      }
    },
    "messages": {
      "rebuild-v2-road": {
        "methods": [
          "rebuildV2Road"
        ]
      },
      "restore-v2-road-baked": {
        "methods": [
          "restoreV2RoadBaked"
        ]
      },
      "check-v2-road-bake": {
        "methods": [
          "checkV2RoadBake"
        ]
      },
      "bake-v2-road": {
        "methods": [
          "bakeV2Road"
        ]
      },
      "bind-v2-road-mesh": {
        "methods": [
          "bindV2RoadMesh"
        ]
      },
      "edit-v2-path": {
        "methods": [
          "editV2Path"
        ]
      },
      "edit-v2-path-group": {
        "methods": [
          "editV2PathGroup"
        ]
      },
      "nudge-v2-path-group": {
        "methods": [
          "nudgeV2PathGroup"
        ]
      },
      "plan-v2-junction-auto-trim": {
        "methods": [
          "planV2JunctionAutoTrim"
        ]
      },
      "apply-v2-junction-auto-trim": {
        "methods": [
          "applyV2JunctionAutoTrim"
        ]
      },
      "plan-v2-junction-endpoint-snap": {
        "methods": [
          "planV2JunctionEndpointSnap"
        ]
      },
      "apply-v2-junction-endpoint-snap": {
        "methods": [
          "applyV2JunctionEndpointSnap"
        ]
      },
      "inspect-v2-road-network": {
        "methods": [
          "inspectV2RoadNetwork"
        ]
      },
      "plan-v2-junction-auto-connect": {
        "methods": [
          "planV2JunctionAutoConnect"
        ]
      },
      "apply-v2-junction-auto-connect": {
        "methods": [
          "applyV2JunctionAutoConnect"
        ]
      },
      "plan-v2-junction-tangents": {
        "methods": [
          "planV2JunctionTangents"
        ]
      },
      "apply-v2-junction-tangents": {
        "methods": [
          "applyV2JunctionTangents"
        ]
      },
      "inspect-v2-junction-seams": {
        "methods": [
          "inspectV2JunctionSeams"
        ]
      }
    },
    "inspector": {
      "section": {
        "node": {
          "Spline.Path": "./dist/contributions/inspector/PathV2.js",
          "Spline.Road": "./dist/contributions/inspector/RoadV2.js",
          "Spline.Extrude": "./dist/contributions/inspector/ExtrudeV2.js",
          "Spline.MeshDeform": "./dist/contributions/inspector/MeshDeformV2.js",
          "Spline.Junction": "./dist/contributions/inspector/JunctionV2.js"
        }
      }
    }
  }
}
